---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "WhatsApp Direct Chat Online | Message Without Saving Number",
	description = "Send WhatsApp messages directly without saving the contact. A free, fast, and secure tool to instantly open a WhatsApp chat via wa.me links."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const schema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "WA Direct Message Tool",
	"description": description,
	"applicationCategory": "CommunicationApplication",
	"operatingSystem": "Any (Web Browser)",
	"offers": {
		"@type": "Offer",
		"price": "0",
		"priceCurrency": "USD"
	}
};
const ogImage = "https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-8BS3MLD4JL" is:inline></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-8BS3MLD4JL');
		</script>

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col selection:bg-green-100 selection:text-green-900">
		<header class="border-b border-slate-200 bg-white">
			<div class="max-w-3xl mx-auto px-4 py-4 sm:py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
				<a href="/" class="flex items-center gap-2 text-xl font-bold text-slate-900">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500" aria-hidden="true">
						<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
					</svg>
					WA Direct
				</a>
				<div class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-50 text-green-700 text-sm font-medium border border-green-100 shadow-sm">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
						<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
					</svg>
					100% Private - No data is saved or tracked
				</div>
			</div>
		</header>

		<main class="flex-grow max-w-3xl w-full mx-auto px-4 py-8 sm:py-12">
			<slot />
		</main>

		<footer class="border-t border-slate-200 bg-white mt-auto">
			<div class="max-w-3xl mx-auto px-4 py-8 text-center text-slate-500 text-sm">
				<p>WA Direct is an independent tool and is not affiliated with WhatsApp Inc. or Meta Platforms, Inc.</p>
				<p class="mt-2">&copy; {new Date().getFullYear()} WA Direct. All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	body {
		font-family: 'Inter', sans-serif;
	}
</style>
